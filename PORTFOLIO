<script>
  // Typewriter effect for the hero code panel
  const Q = '"';
  const codeLines = [
    { t: [["kw","const"], ["p"," "], ["v","developer"], ["p"," = {"]] },
    { t: [["p","  "], ["k","name"], ["p",": "], ["str",Q+"Nandni Nirmal"+Q], ["p",","]] },
    { t: [["p","  "], ["k","role"], ["p",": "], ["str",Q+"CS Undergrad @ VIT Bhopal"+Q], ["p",","]] },
    { t: [["p","  "], ["k","focus"], ["p",": "], ["p","["], ["str",Q+"Deep Learning"+Q],["p",", "],["str",Q+"Full-Stack"+Q],["p","]"], ["p",","]] },
    { t: [["p","  "], ["k","stack"], ["p",": "], ["p","["], ["str",Q+"Python"+Q],["p",", "],["str",Q+"React"+Q],["p",", "],["str",Q+"Node.js"+Q],["p","]"], ["p",","]] },
    { t: [["p","  "], ["k","status"], ["p",": "], ["str",Q+"compiling ambition..."+Q]] },
    { t: [["p","}"]] },
    { t: [] },
    { t: [["com","// always building, always learning"]] },
  ];
  const colorMap = { kw:"tk-kw", k:"tk-key", str:"tk-str", v:"tk-fn", p:"tk-punc", com:"tk-com" };
  function renderLineHTML(tokens){
    return tokens.map(([type,text]) => {
      const cls = colorMap[type] || "";
      const safe = text.replace(/</g,"&lt;").replace(/>/g,"&gt;");
      return cls ? `<span class="${cls}">${safe}</span>` : safe;
    }).join("");
  }
  const el = document.getElementById('typedCode');
  let lineIdx = 0, charIdx = 0, builtHTML = "";
  function typeStep(){
    if(lineIdx >= codeLines.length){ el.innerHTML = builtHTML + '<span class="caret"></span>'; return; }
    const tokens = codeLines[lineIdx].t;
    const flat = tokens.map(t => t[1]).join("");
    if(charIdx <= flat.length){
      let remaining = charIdx; const partialTokens = [];
      for(const [type,text] of tokens){
        if(remaining <= 0) break;
        if(remaining >= text.length){ partialTokens.push([type,text]); remaining -= text.length; }
        else{ partialTokens.push([type,text.slice(0,remaining)]); remaining = 0; }
      }
      el.innerHTML = builtHTML + renderLineHTML(partialTokens) + '<span class="caret"></span>';
      charIdx++;
      setTimeout(typeStep, 35);
    } else {
      builtHTML += renderLineHTML(tokens) + "\n";
      lineIdx++; charIdx = 0;
      setTimeout(typeStep, 150);
    }
  }
  setTimeout(typeStep, 600);
</script>
